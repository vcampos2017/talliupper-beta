# Optional cloud fallback only. Local OCR does not need a key.
# The app also lets you enter this securely in its sidebar.
OPENAI_API_KEY=replace_with_your_api_key

# Optional model override.
OPENAI_RECEIPT_MODEL=gpt-5.4-mini

# Optional custom location for the SQLite database.
# RECEIPT_DATA_DIR=C:\\Users\\YourName\\Documents\\ReceiptLensData
